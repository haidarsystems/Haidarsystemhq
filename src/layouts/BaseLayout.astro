---
const { title = 'Haidar System', description = 'Building practical digital systems for real-world problems.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">HAIDAR<span>SYSTEM</span></a>
      <nav aria-label="Main navigation">
        <a href="/build">Build</a>
        <a href="/projects">Projects</a>
        <a href="/thinking">Thinking</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>Haidar System</span>
      <span>Real problems → useful systems → practical action.</span>
    </footer>
  </body>
</html>
<style is:global>
  :root { font-family: Inter, ui-sans-serif, system-ui, sans-serif; color: #171717; background: #f5f5f2; line-height: 1.6; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  a { color: inherit; text-decoration: none; }
  .site-header { max-width: 1180px; margin: auto; padding: 24px 28px; display:flex; justify-content:space-between; align-items:center; gap:24px; border-bottom:1px solid #d8d8d2; }
  .brand { font-weight:800; letter-spacing:.08em; font-size:.9rem; }
  .brand span { font-weight:400; }
  nav { display:flex; gap:22px; font-size:.9rem; }
  nav a:hover { text-decoration:underline; }
  main { min-height: calc(100vh - 150px); }
  .site-footer { max-width:1180px; margin:auto; padding:30px 28px; border-top:1px solid #d8d8d2; display:flex; justify-content:space-between; gap:20px; color:#666; font-size:.8rem; }
  @media (max-width:700px) { .site-header { align-items:flex-start; flex-direction:column; } nav { flex-wrap:wrap; gap:12px 18px; } .site-footer { flex-direction:column; } }
</style>
