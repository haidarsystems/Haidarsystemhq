---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}

const { project } = Astro.props;
const { data } = project;
const proof = [
  ['Problem', data.problem],
  ['Demand / Reason', data.reason],
  ['System', data.system],
  ['Implementation', data.implementation],
  ['Result', data.result],
  ['Lesson / Next Step', data.lesson],
];
---
<BaseLayout title={`${data.name} — Projects — Haidar System`} description={data.summary} type="article">
  <article class="wrap page">
    <a class="back-link text-link" href="/projects/">← All projects</a>
    <header class="project-hero">
      <div><p class="eyebrow">Project proof</p><h1 class="page-title">{data.name}</h1></div>
      <span class="status">{data.status}</span>
      <p class="lead">{data.summary}</p>
    </header>

    <div class="proof-grid">
      {proof.map(([label, value], index) => (
        <section class="proof-row" aria-labelledby={`proof-${index}`}>
          <span class="section-number">0{index + 1}</span>
          <h2 id={`proof-${index}`}>{label}</h2>
          <p>{value}</p>
        </section>
      ))}
    </div>

    <div class="project-meta">
      <section class="meta-block" aria-labelledby="technology-title">
        <h2 id="technology-title">Technology</h2>
        <ul>{data.technology.map((item: string) => <li>{item}</li>)}</ul>
      </section>
      <section class="meta-block" aria-labelledby="links-title">
        <h2 id="links-title">Links</h2>
        {data.links.length > 0 ? <ul>{data.links.map((link: { label: string; url: string }) => <li><a class="text-link" href={link.url} target="_blank" rel="noreferrer">{link.label} ↗</a></li>)}</ul> : <p>No verified external project link is currently published.</p>}
      </section>
    </div>
    <p class="meta" style="margin-top: 1.5rem">Updated {data.updated_at.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: '2-digit' })}</p>
  </article>
</BaseLayout>
