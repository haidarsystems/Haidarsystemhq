---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Contact — Haidar System">
<section class="wrap page"><p class="eyebrow">CONTACT</p><h1>Bring a real problem.</h1><p class="intro">If you have a workflow, business problem, or opportunity that may be worth turning into a practical digital system, start a conversation.</p><div class="contact"><a href="mailto:hello@haidarsystemhq.com">hello@haidarsystemhq.com →</a><a href="https://instagram.com/haidarsystemhq" target="_blank" rel="noreferrer">Instagram @haidarsystemhq →</a></div></section>
</BaseLayout>
<style>.wrap{max-width:1180px;margin:auto;padding:0 28px}.page{padding-top:90px;padding-bottom:120px}.eyebrow{font-size:.72rem;letter-spacing:.16em;font-weight:700;color:#73736d}h1{font-size:clamp(3.5rem,8vw,7rem);line-height:.95;letter-spacing:-.06em;margin:0}.intro{max-width:650px;color:#666;font-size:1.15rem;margin:35px 0 60px}.contact{display:flex;flex-direction:column;align-items:flex-start;gap:18px;font-weight:700}.contact a:hover{text-decoration:underline}
</style>
