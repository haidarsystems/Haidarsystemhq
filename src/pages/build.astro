---
import BaseLayout from '../layouts/BaseLayout.astro';
const capabilities = [
  ['Business Systems', 'Clarify repeated operational work, information flow, ownership, and decisions—then shape the smallest practical internal system around it.'],
  ['AI Systems', 'Use AI to support research, decisions, interfaces, and execution where human ownership and useful outcomes remain clear.'],
  ['Automation & Integration', 'Connect APIs, webhooks, tools, and data flows to reduce handoff friction and make repeated actions more reliable.'],
  ['Web & Digital Interfaces', 'Build public websites, focused web applications, and internal interfaces that make information and actions easier to use.'],
  ['Intelligence & Opportunity Systems', 'Capture demand signals, organize research, score opportunities, and create a clearer route from evidence to action.'],
  ['Emerging Technology', 'Investigate blockchain, Web3, and other emerging tools only when they address a real problem or produce meaningful learning.'],
];
---
<BaseLayout title="What I Build — Haidar System" description="Capability territories for practical business, AI, automation, web, intelligence, and emerging technology systems.">
  <section class="wrap page" aria-labelledby="build-title">
    <p class="eyebrow">Capabilities</p>
    <h1 class="page-title" id="build-title">Useful systems, not technology for its own sake.</h1>
    <p class="lead">Capabilities are organized around the problems and workflows they can improve. They are build territories—not an inflated claim that every service is already proven at production scale.</p>
    <div class="capability-list">
      {capabilities.map(([title, description], index) => (
        <article class="capability-row">
          <span class="section-number">0{index + 1}</span>
          <h2>{title}</h2>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </section>
  <section class="wrap cta" aria-labelledby="build-cta">
    <div><p class="eyebrow">The filter</p><h2 class="section-title" id="build-cta">Who has the problem, how do we know, and what action becomes easier?</h2></div>
    <a class="button" href="/contact/">Bring a problem →</a>
  </section>
</BaseLayout>
