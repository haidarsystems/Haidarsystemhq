---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteCard from '../../components/NoteCard.astro';

const notes = (await getCollection('thinking', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.updated_at.valueOf() - a.data.updated_at.valueOf());
---
<BaseLayout title="Thinking — Haidar System" description="Working notes about systems thinking, demand validation, AI, automation, experiments, and practical build decisions.">
  <section class="wrap page" aria-labelledby="thinking-title">
    <p class="eyebrow">Thinking</p>
    <h1 class="page-title" id="thinking-title">Notes from building in public.</h1>
    <p class="lead">Short working ideas about systems, demand, AI, automation, and lessons from experiments. Notes are structured content, so the reasoning layer can grow without changing route logic.</p>
    <div class="note-list" style="margin-top: 4rem">
      {notes.map(({ data }) => <NoteCard slug={data.slug} title={data.title} summary={data.summary} tags={data.tags} date={data.updated_at} />)}
    </div>
  </section>
</BaseLayout>
