---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NoteCard from '../components/NoteCard.astro';

const capabilities = [
  ['Business Systems', 'Turn repeated operational work into clear, usable workflows.'],
  ['AI Systems', 'Apply AI where it improves research, decisions, or execution.'],
  ['Automation & Integration', 'Connect tools, data, and actions across a real process.'],
  ['Web & Digital Interfaces', 'Create focused interfaces that make a system understandable and usable.'],
  ['Intelligence & Opportunity Systems', 'Capture demand signals and move promising opportunities toward action.'],
  ['Emerging Technology', 'Explore new technology only when the problem or learning objective is clear.'],
];
const projects = (await getCollection('projects')).filter(({ data }) => data.featured);
const notes = (await getCollection('thinking', ({ data }) => data.status === 'published'))
  .sort((a, b) => b.data.updated_at.valueOf() - a.data.updated_at.valueOf())
  .slice(0, 3);
---
<BaseLayout>
  <section class="hero wrap" aria-labelledby="home-title">
    <p class="eyebrow">Personal operating brand · 2026</p>
    <h1 class="display" id="home-title">Building practical digital systems for <em>real-world problems.</em></h1>
    <p class="lead">I explore problems, validate opportunities, design systems, and build practical solutions across AI, software, automation, and emerging technology.</p>
    <div class="actions">
      <a class="button" href="/projects/">Explore the work →</a>
      <a class="text-link" href="/about/">How the system works</a>
    </div>
  </section>

  <section class="section" aria-labelledby="focus-title">
    <div class="wrap focus-grid">
      <div><p class="eyebrow">Current focus</p><h2 class="section-title" id="focus-title">Demand before unnecessary building.</h2></div>
      <div>
        <p class="lead">Find real problems first, then build the smallest useful system that can act on them.</p>
        <div class="focus-flow" aria-label="Current strategic direction">
          <span>Demand intelligence</span><span>Opportunity database</span><span>Scoring</span><span>Action</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="capabilities-title">
    <div class="section-head"><div><p class="eyebrow">Capability map</p><h2 class="section-title" id="capabilities-title">What I build</h2></div><a class="text-link" href="/build/">View capability system →</a></div>
    <div class="capability-grid">
      {capabilities.map(([title, text], index) => <article class="capability-card"><span class="section-number">0{index + 1}</span><h3>{title}</h3><p>{text}</p></article>)}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="proof-title">
    <div class="section-head"><div><p class="eyebrow">Project proof</p><h2 class="section-title" id="proof-title">Selected work</h2></div><a class="text-link" href="/projects/">View all projects →</a></div>
    <div class="project-grid">
      {projects.map(({ data }) => <ProjectCard slug={data.slug} name={data.name} status={data.status} summary={data.summary} headingLevel="h3" />)}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="thinking-title">
    <div class="section-head"><div><p class="eyebrow">Thinking</p><h2 class="section-title" id="thinking-title">Working notes</h2></div><a class="text-link" href="/thinking/">View all notes →</a></div>
    <div class="note-list">
      {notes.map(({ data }) => <NoteCard slug={data.slug} title={data.title} summary={data.summary} tags={data.tags} date={data.updated_at} headingLevel="h3" />)}
    </div>
  </section>

  <section class="wrap cta" aria-labelledby="contact-title">
    <div><p class="eyebrow">Start a conversation</p><h2 class="section-title" id="contact-title">Have a real problem worth turning into a system?</h2></div>
    <a class="button" href="/contact/">Start here →</a>
  </section>
</BaseLayout>
